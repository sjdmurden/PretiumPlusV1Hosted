@{
}
<div class="space-y-4">

    <div>
        <span class="text-lg font-semibold text-gray-900">Quotes</span>
    </div>

    <!-- SEARCH -->
    <div>
        <button onclick="toggleForm(this, 'quoteSearchForm')"
                class="w-full px-3 py-2 bg-blue-100 rounded-md">
            Search
        </button>

        <form class="quoteSearchForm hidden space-y-2 mt-2">
            <input type="text" class="w-full border px-2 py-1 rounded" placeholder="Quote #" />
            <button class="w-full bg-blue-600 text-white py-2 rounded">Search</button>
        </form>
    </div>

    <!-- CREATE -->
    <div>
        <button onclick="toggleForm(this, 'createQuoteForm')"
                class="w-full px-3 py-2 bg-green-100 rounded-md">
            Create
        </button>

        <form class="createQuoteForm hidden space-y-2 mt-2">
            <input type="file" class="w-full border rounded">
            <button class="w-full bg-green-600 text-white py-2 rounded">Upload</button>
        </form>
    </div>

</div>